# URL of the Express API (server-side only, used by Next.js route handlers)
BACKEND_API_URL=http://localhost:5000

# Must match JWT_SECRET / JWT_ISSUER / JWT_AUDIENCE in the Express .env
EVENTS_JWT_SECRET=replace-with-the-same-long-random-secret
EVENTS_JWT_ISSUER=frosttogether-web
EVENTS_JWT_AUDIENCE=frosttogether-api
